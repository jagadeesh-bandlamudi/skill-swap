# ============================================================
# SkillSwap backend environment — copy this file to ".env"
# and fill in your own values.  cp .env.example .env
# ============================================================

# --- Database ---
# Your MongoDB connection string (e.g. MongoDB Atlas).
# If this is unreachable, the server AUTOMATICALLY falls back to a
# local database stored in backend/.localdb — so the app still runs.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/share2learn?appName=Cluster0

# --- Auth ---
# Secret used to sign JWT login tokens. Use a long, random string.
JWT_SECRET=change_this_to_a_long_random_secret

# --- Email (for OTP verification & admin notifications) ---
# Uses Gmail SMTP. Create a Gmail "App Password" (16 chars) and put it below.
# If email can't be sent, the OTP is printed to the server console instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# --- Server ---
# Port the backend + frontend are served on (HTTPS). Default: 5000
PORT=5000
